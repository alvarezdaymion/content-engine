<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd: one tick every hour.
  1. Replace /path/to/content-engine and /path/to/uv (run `which uv`).
  2. cp examples/scheduling/com.example.content-engine.plist ~/Library/LaunchAgents/
  3. launchctl load ~/Library/LaunchAgents/com.example.content-engine.plist
  The command loads .env from the repo folder, so keep credentials there (never committed).
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.content-engine</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>cd /path/to/content-engine &amp;&amp; /path/to/uv run --env-file .env content-engine run</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/content-engine.log</string>
  <key>StandardErrorPath</key><string>/tmp/content-engine.log</string>
</dict>
</plist>
