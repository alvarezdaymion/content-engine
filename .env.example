# Copy to .env (never commit it) or export these in the environment your scheduler uses.
# Load the file explicitly: uv run --env-file .env content-engine check
# Everything is optional: set only what you turn on. Dry runs never read the publishing credentials.

# Idea source: YouTube Data API v3 key (read-only searches).
YOUTUBE_API_KEY=

# Optional AI voice for the questions ([tts] enabled = true). Billed per character.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Publishing, read only when [publish] mode = "live" and the platform is in [publish] platforms.
# Facebook Page: a Page access token with pages_manage_posts and pages_read_engagement.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Instagram professional account (Instagram Login): instagram_business_content_publish.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Threads: threads_basic and threads_content_publish.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# X: the app's consumer key and secret, and the account's Read and Write access token.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# YouTube: an OAuth client and a refresh token with the youtube.upload scope.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# TikTok Content Posting API: client key and secret, and a refresh token with video.upload.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
